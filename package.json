{
  "name": "@1msg/mcp",
  "version": "1.2.0",
  "description": "MCP server for the 1msg API (stdio + Streamable HTTP)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1msg/1msg-mcp.git"
  },
  "homepage": "https://github.com/1msg/1msg-mcp#readme",
  "bugs": {
    "url": "https://github.com/1msg/1msg-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "1msg-mcp": "./dist/index.js",
    "@1msg/mcp": "./dist/index.js",
    "1msg-mcp-http": "./dist/http.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "jest",
    "smoke:tools-list": "node scripts/smoke-tools-list.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@1msg/sdk": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
