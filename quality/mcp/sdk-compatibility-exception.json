  "issue": "https://plane.1msg.io/1msg/browse/1MSG-156/",
  "expires": "2026-12-11",
  "scope": "Parameter-list compatibility between the public-contract-generated SDK and the locked published SDK used by MCP. No assertion of full wire compatibility is made for these operations.",
