{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "jsx": "preserve",
    "isolatedModules": true
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "tools/quality/**",
    "quality/reports/**",
    "quality/mcp/vendor/apis/**"
  ]
}
